<?xml version="1.0"?>
<sdf version="1.11">
  <world name="rooms">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.9 0.9 0.9</background_color>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
        </gz-gui>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4</ambient><diffuse>0.5 0.5 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 外墙宏 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>12 0.2 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>12 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>12 0.2 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>12 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 1.5 0 0 1.57</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>10 0.2 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1.5 0 0 1.57</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>10 0.2 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.6</ambient><diffuse>0.7 0.7 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 内墙——走廊 -->
    <model name="inner_wall_left">
      <static>true</static>
      <pose>-2 0 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 4 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 4 3</size></box></geometry>
          <material><ambient>0.5 0.5 0.7</ambient><diffuse>0.5 0.5 0.7</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_right">
      <static>true</static>
      <pose>2 0 1.5 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 4 3</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 4 3</size></box></geometry>
          <material><ambient>0.5 0.5 0.7</ambient><diffuse>0.5 0.5 0.7</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 房间里的障碍物 -->
    <model name="block_1">
      <static>true</static>
      <pose>4 -2 0.5 0 0 0</pose>
      <link name="block_link">
        <collision name="block_collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="block_visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.3 0.6 0.3</ambient><diffuse>0.3 0.6 0.3</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_2">
      <static>true</static>
      <pose>-4 2 0.5 0 0 0.785</pose>
      <link name="block_link">
        <collision name="block_collision">
          <geometry><box><size>0.6 0.6 1</size></box></geometry>
        </collision>
        <visual name="block_visual">
          <geometry><box><size>0.6 0.6 1</size></box></geometry>
          <material><ambient>0.6 0.3 0.3</ambient><diffuse>0.6 0.3 0.3</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_1">
      <static>true</static>
      <pose>-3 -2 0.5 0 0 0</pose>
      <link name="cylinder_link">
        <collision name="cylinder_collision">
          <geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry>
        </collision>
        <visual name="cylinder_visual">
          <geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.6</ambient><diffuse>0.3 0.3 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_3">
      <static>true</static>
      <pose>4 1 0.5 0 0 0</pose>
      <link name="block_link">
        <collision name="block_collision">
          <geometry><box><size>1.2 0.8 1</size></box></geometry>
        </collision>
        <visual name="block_visual">
          <geometry><box><size>1.2 0.8 1</size></box></geometry>
          <material><ambient>0.6 0.5 0.3</ambient><diffuse>0.6 0.5 0.3</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
